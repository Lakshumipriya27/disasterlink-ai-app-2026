# Backend environment example (the backend reads backend/.env). Frontend options: frontend/.env.example

# Copy this file to ".env" (same folder) and adjust if needed. All values are optional.

# Database. Default is a local SQLite file in backend/data/.
# PostgreSQL example (requires psycopg2-binary): postgresql+psycopg2://user:pass@localhost:5432/disasterlink
DATABASE_URL=

# JWT signing secret. If empty, a random secret is generated once and stored in backend/data/.secret_key
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Seed the simulated Chennai flood scenario on first start (true/false)
SEED_ON_STARTUP=true

# Max media upload size in megabytes
MAX_UPLOAD_MB=25

# Optional external AI enhancement. Leave AI_PROVIDER=none to use only the local rule-based engine.
# To enable: AI_PROVIDER=anthropic, set ANTHROPIC_API_KEY, and `pip install anthropic`.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
